{
  "name": "malipen",
  "version": "1.0.2",
  "repository": "https://github.com/maliyildirimtr/MaliPen",
  "author": "MaliYildirimTR",
  "description": "Production-quality screen annotation application",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:win": "npm run build && electron-builder --win --x64",
    "release": "npm run build && electron-builder --publish always",
    "preview": "vite preview"
  },
  "build": {
    "appId": "com.tankstudios.malipen",
    "productName": "MaliPen",
    "publish": [
      {
        "provider": "github",
        "owner": "maliyildirimtr",
        "repo": "MaliPen",
        "releaseType": "release"
      }
    ],
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "afterPack": "./build/afterPack.js",
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "build/icon.png",
      "artifactName": "MaliPen-mac.${ext}"
    },
    "dmg": {
      "title": "MaliPen Installer",
      "icon": "build/icon.png"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.png",
      "artifactName": "MaliPen-windows.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "lucide-react": "^0.363.0",
    "perfect-freehand": "^1.2.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.66",
    "@types/react-dom": "^18.2.22",
    "@vitejs/plugin-react": "^4.2.1",
    "electron": "^29.1.5",
    "electron-builder": "^24.13.3",
    "happy-dom": "^20.11.12",
    "jsdom": "^30.0.1",
    "typescript": "^5.2.2",
    "vite": "^5.2.0",
    "vite-plugin-electron": "^0.28.4",
    "vite-plugin-electron-renderer": "^0.14.5",
    "vitest": "^1.6.0"
  }
}
